# Credenciales de la API de HackerOne (obligatorias para `nexus recon`).
H1_USER=tu_usuario
H1_TOKEN=tu_api_token

# Opcional: rutas a las herramientas si no están en el PATH del servicio.
# NEXUS_NUCLEI_PATH=/opt/tools/nuclei
# NEXUS_SUBFINDER_PATH=/opt/tools/subfinder
# NEXUS_HTTPX_PATH=/opt/tools/httpx

# Auto-envío a H1 (IRREVERSIBLE: crea reportes reales). Déjalo en 0 hasta haber
# previsualizado con `nexus submit --auto --dry-run`. A 1, cada `scan` reporta
# solo el tramo VERIFIED+explotable+alta confianza.
# NEXUS_AUTO_SUBMIT=0

# Presupuesto de tiempo del ciclo `hunt`, en segundos (0 = sin límite). Ponlo por
# DEBAJO del TimeoutStartSec del .service (p.ej. 2700 contra 3600): el ciclo para
# limpio y guarda lo escaneado antes de que systemd lo mate por SIGKILL — que es
# lo que dejaba filas de scan_logs colgadas en 'running' para siempre.
# NEXUS_SCAN_DEADLINE_SECS=2700

# --- SSRF out-of-band (colector auto-hospedado, fase 3.1b) ---
# Base pública del colector (`nexus oob-server`). Si se fija, la sonda SSRF del
# ciclo hunt inyecta ADEMÁS un callback y confirma el SSRF CIEGO. Sin fijar, la
# fase SSRF es solo in-band. Usa la IP CRUDA del VPS (sin DNS ni terceros); el
# puerto debe coincidir con NEXUS_OOB_PORT y estar abierto al mundo.
# NEXUS_OOB_BASE=http://192.99.42.108:8004
# Puerto en el que escucha el colector (bind 0.0.0.0). Defecto 8004.
# NEXUS_OOB_PORT=8004
# Segundos de gracia que la sonda espera el callback antes de consultar. Defecto 12.
# NEXUS_OOB_WAIT=12
# BD AISLADA del colector público (findings viven en la principal; el colector NO
# la abre). Defecto: oob.db junto a la BD principal. Debe ser la MISMA para el
# servicio `nexus oob-server` y para el ciclo `hunt`.
# NEXUS_OOB_DB=/home/debian/nexus/oob.db

# Verificación VIVA de secretos (usa la credencial AJENA hallada contra el
# proveedor real para ver si está viva). OPT-IN: por defecto un secreto detectado
# va a revisión manual, sin tocar al tercero. Enciéndelo SOLO si el alcance del
# programa autoriza usar la credencial encontrada.
# NEXUS_SECRET_VERIFY=0
